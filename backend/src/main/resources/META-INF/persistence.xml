<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    
    <persistence-unit name="bugboard-pu" transaction-type="JTA">
        <jta-data-source>java:app/jdbc/bugboard</jta-data-source>
        
        <class>com.bugboard.model.User</class>
        <class>com.bugboard.model.Issue</class>
        <class>com.bugboard.model.IssueHistoryEntry</class>
        <class>com.bugboard.model.Comment</class>
        <class>com.bugboard.model.PasswordResetRequest</class>
        
        <properties>
            <property name="jakarta.persistence.schema-generation.database.action" value="create-or-extend-tables"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
